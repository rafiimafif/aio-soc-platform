FROM node:20-alpine

# Upgrade OS packages to patch base vulnerabilities
RUN apk update && apk upgrade --no-cache

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Install dependencies and clean up package managers to remove vulnerabilities
RUN npm ci --only=production && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /opt/yarn-v*

# Copy backend files
COPY backend ./backend

# Expose port
EXPOSE 3001

# Set production env
ENV NODE_ENV=production

# Run command
CMD ["node", "backend/index.js"]
